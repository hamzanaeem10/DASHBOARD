# Which backend the chatbot uses: groq or anthropic.
# Leave unset and the app picks whichever key is present.
LLM_PROVIDER=groq

# Groq (default).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (set LLM_PROVIDER=anthropic to use this instead).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: path to the workbook loaded when nothing is uploaded.
# TICKETS_XLSX=E:\dashboardtickets\2026 Tickets.xlsx
